# ============================================================
# ESP32-C5 N16R8 — Target deauther firmware
# ============================================================

CONFIG_IDF_TARGET="esp32c5"

# ---------- FLASH & PSRAM ----------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------- CONSOLE ----------
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y

# ---------- WIFI ----------
CONFIG_ESP_WIFI_ENABLED=y
# SoftAP support is REQUIRED by the Evil Portal captive-portal feature
# (WIFI_MODE_AP + DHCP server). It was previously disabled to save flash/RAM;
# re-enabling it costs some flash + a little SRAM, so check `idf.py size`
# headroom on the N16R8 after building.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# ---------- BLUETOOTH (NimBLE) ----------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
# Observer role — WAJIB untuk BLE Scanner (ble_gap_disc / ble_gap_ext_disc).
# Tanpa ini fungsi scan tidak ter-link.
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y

# ============================================================
# BLE 5.0 EXTENDED ADVERTISING — WAJIB untuk BLE Spam
# Ketiga opsi di bawah harus aktif agar ble_gap_ext_adv_* tersedia
# ============================================================
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=4

# Controller: connections + advertising instances + margin
CONFIG_BT_CTRL_BLE_MAX_ACT=10

# ============================================================
# WIFI + BLUETOOTH COEXISTENCE
# ============================================================
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ---------- LOGGING ----------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# ---------- FREERTOS ----------
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# ---------- NVS ----------
CONFIG_NVS_ENCRYPTION=n

# ---------- INFRARED (RMT) ----------
# NOTE: the IR feature deliberately adds ~0 IRAM so it can never cause an
# IRAM/SRAM overflow on top of the WiFi+BLE+nRF24 stack (C5 has a single
# 384 KB SRAM shared between IRAM and DRAM/heap). Robustness against flash
# writes during capture is handled WITHOUT extra IRAM: ir_save_last() pauses
# the RMT RX hardware across its LittleFS write, and the RX callback never
# writes flash. If you have confirmed IRAM headroom with `idf.py size` and
# want the RX ISR serviceable even during unrelated flash writes, add:
#   CONFIG_RMT_RX_ISR_CACHE_SAFE=y
# (the RX done callback is already IRAM_ATTR, so it is ready for that option).

# ---------- SUB-GHZ TX (GPTimer) ----------
# The Sub-GHz OOK transmitter toggles GDO0 from a GPTimer on_alarm callback.
# By default that callback lives in flash (0 IRAM): it runs correctly because
# Sub-GHz TX itself never writes flash, so the cache stays enabled. A flash
# write from an UNRELATED task during a transmit would only DELAY an edge
# (jitter), not crash — tolerable for OOK remotes (pulses >= ~100 us). If an
# oscilloscope shows jitter under system load and you have IRAM headroom
# (`idf.py size`), make TX timing cache-immune by enabling:
#   CONFIG_GPTIMER_ISR_CACHE_SAFE=y
#   CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
# The on_alarm callback is already guarded (IRAM_ATTR under
# CONFIG_GPTIMER_ISR_CACHE_SAFE), its data is in internal RAM, and its
# gptimer_alarm_config_t is static, so it is ready for that option.
# NOTE: ESP-IDF marks a GPTimer alarm period < 5 us as not recommended; the TX
# backend clamps shorter pulses to 5 us and warns (`subghz: WARN tx-subus`).
